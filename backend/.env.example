# Copy to .env (never commit .env). Everything is optional; the app runs with none of it.

# Tiger Data / TimescaleDB. Unset = in-memory store.
# DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Gemini (language only). Unset = template fallbacks.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

UNIT_TZ=America/Toronto
SEED_DEMO_DATA=1
CONSULT_TIMEOUT_S=120
WELFARE_TIMEOUT_S=45
CORS_ORIGINS=*

# Demo login accounts (patient@medicue.demo / nurse@medicue.demo). Unset = "patient" / "nurse",
# which is fine for synthetic data but should be overridden for any real deploy.
# DEMO_PATIENT_PASSWORD=
# DEMO_NURSE_PASSWORD=
# DEMO_PATIENT_ID=p-chen